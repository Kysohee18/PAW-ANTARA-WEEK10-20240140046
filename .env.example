PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=cs_bot_db
DB_USER=postgres
DB_PASS=postgres

SESSION_SECRET=ganti-dengan-secret-yang-random

# Ambil API key gratis di https://aistudio.google.com/app/apikey
# JANGAN commit file .env ini ke git, JANGAN share ke siapapun,
# JANGAN taruh di kode frontend/client - taruh cuma di server
GEMINI_API_KEY=isi-api-key-kamu-disini

# nama toko, dipake di system prompt biar bot tau identitasnya
STORE_NAME=Toko Kita
